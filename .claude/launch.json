{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "komb-storefront",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "komb-production",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "komb-mock",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "SHOPIFY_STORE_DOMAIN=",
        "npx",
        "next",
        "dev",
        "-p",
        "3200"
      ],
      "port": 3200
    }
  ]
}