# Copy to .env.local and fill in to switch from mock data to the live Shopify store.
# Shopify admin > Sales channels > Headless > Storefront API.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Set either token. The private one is preferred (server-only, higher limits);
# the public one is the fallback. NEXT_PUBLIC_SHOPIFY_STOREFRONT_PUBLIC_TOKEN
# is also accepted in place of SHOPIFY_STOREFRONT_ACCESS_TOKEN.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# For subscriptions, the token also needs the unauthenticated_read_selling_plans
# scope, and a subscription app must have plans attached to the products.
SHOPIFY_API_VERSION=2026-07
# Shopify's hosted customer accounts, where customers sign in, see orders and
# manage subscriptions: https://account.komb.ca or https://shopify.com/<shop-id>/account
# Leave empty to keep the header's Account link on the placeholder page.
NEXT_PUBLIC_SHOPIFY_ACCOUNT_URL=

# The affiliate app's application form (UpPromote, GoAffPro, Shopify Collabs or
# similar). Empty: the Affiliates page's Apply button emails info@komb.ca.
NEXT_PUBLIC_AFFILIATE_SIGNUP_URL=

# Footer email sign-up. Set ONE provider; with neither, the form shows a
# preview message and saves nothing.
# Klaviyo: a private API key with list and profile write access, and the list id.
KLAVIYO_PRIVATE_API_KEY=
KLAVIYO_LIST_ID=
# Klaviyo's public site ID (6 characters, Settings > API keys > Public API
# key). With it set, the sign-up pop-up shows the Klaviyo form below instead
# of the built-in one. The form must be an "Embed" type form in Klaviyo.
NEXT_PUBLIC_KLAVIYO_COMPANY_ID=
NEXT_PUBLIC_KLAVIYO_POPUP_FORM_ID=Vh4T9x
# Or Shopify: an Admin API token (custom app) with the write_customers scope.
# This is a secret, separate from the public Storefront token above.
SHOPIFY_ADMIN_ACCESS_TOKEN=
