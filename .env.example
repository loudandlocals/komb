# Copy to .env.local and fill in to switch from mock data to the live Shopify store.
# Shopify admin > Sales channels > Headless > Storefront API > public access token.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# For subscriptions, the token also needs the unauthenticated_read_selling_plans
# scope, and a subscription app must have plans attached to the products.
SHOPIFY_API_VERSION=2026-07
# Shopify's hosted customer accounts, where customers sign in, see orders and
# manage subscriptions: https://account.komb.ca or https://shopify.com/<shop-id>/account
# Leave empty to keep the header's Account link on the placeholder page.
NEXT_PUBLIC_SHOPIFY_ACCOUNT_URL=
